{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autonomous-life-kit:obsidian-topic-schema:1.0",
  "title": "Тема автономной картотеки",
  "description": "Независимый машинный контракт для frontmatter 32 тематических страниц Obsidian.",
  "type": "object",
  "required": [
    "id",
    "title",
    "версия_схемы",
    "тип",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^картотека-тема-(0[1-9]|[12][0-9]|3[0-2])$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "pattern": "[А-Яа-яЁё]"
    },
    "версия_схемы": {
      "const": "1.0"
    },
    "тип": {
      "const": "тип/тема"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "область/безопасность/угрозы",
          "область/безопасность/связь-и-карты",
          "область/безопасность/наблюдение-и-защита",
          "область/жизнеобеспечение/вода",
          "область/жизнеобеспечение/санитария",
          "область/жизнеобеспечение/жильё",
          "область/жизнеобеспечение/зимний-цикл",
          "область/здоровье/первая-помощь",
          "область/здоровье/лекарства",
          "область/питание/запас",
          "область/питание/безопасность",
          "область/питание/семена",
          "область/питание/дикорастущие-растения",
          "область/питание/грибы",
          "область/питание/рыболовство",
          "область/питание/животные",
          "область/место/водный-транспорт",
          "область/место/португалия",
          "область/энергия/электричество",
          "область/энергия/топливо",
          "область/мастерская/инструменты",
          "область/мастерская/измерения",
          "область/мастерская/материалы-и-строительство",
          "область/мастерская/одежда-и-текстиль",
          "область/мастерская/ремёсла",
          "область/общество/управление-группой",
          "область/знания/архив",
          "область/знания/восстановление-технологий",
          "область/знания/образование",
          "область/готовность/испытания",
          "готовность/карта",
          "проверка/требуется",
          "география/общая",
          "география/португалия",
          "горизонт/сейчас",
          "горизонт/72-часа",
          "горизонт/месяц",
          "горизонт/сезон",
          "горизонт/многолетний",
          "горизонт/поколение",
          "риск/обычный",
          "риск/повышенный",
          "риск/смешанный",
          "возраст/дошкольный",
          "возраст/школьный",
          "возраст/профессиональный-и-вуз"
        ]
      },
      "allOf": [
        {"contains": {"pattern": "^область/"}, "minContains": 1, "maxContains": 1},
        {"contains": {"pattern": "^готовность/"}, "minContains": 1, "maxContains": 1},
        {"contains": {"pattern": "^проверка/"}, "minContains": 1, "maxContains": 1},
        {"contains": {"pattern": "^география/"}, "minContains": 1, "maxContains": 1},
        {"contains": {"pattern": "^горизонт/"}, "minContains": 1, "maxContains": 1},
        {"contains": {"pattern": "^риск/"}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {"enum": ["картотека-тема-30", "картотека-тема-31", "картотека-тема-32"]}
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "tags": {
            "minItems": 7,
            "maxItems": 7,
            "contains": {"pattern": "^возраст/"},
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "tags": {
            "minItems": 6,
            "maxItems": 6,
            "not": {"contains": {"pattern": "^возраст/"}}
          }
        }
      }
    }
  ],
  "x-relation-types": ["нужно до", "следующий шаг", "открывает", "при аварии"],
  "x-required-tag-dimensions": ["область", "готовность", "проверка", "география", "горизонт", "риск"],
  "x-optional-tag-dimensions": ["возраст"],
  "additionalProperties": true
}
